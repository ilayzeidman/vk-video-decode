{
    "configurations": [
    {
        "name": "vk-video-decode Debug",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}\\build\\Debug\\vk_video_decode.exe",
        "MIMode": "gdb",
        "cwd": "${workspaceFolder}",
        "preLaunchTask": "CMake Build Debug",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    }
    ]
}